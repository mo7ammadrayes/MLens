# Files gcloud does NOT upload for `gcloud run deploy --source .`
# (Dockerfile and requirements.txt must stay uploaded.)
.gcloudignore
/.git/
.gitignore
.env
.env.*
**/.env
/.venv/
/venv/
/.vscode/
/.idea/
**/__pycache__/
**/*.pyc
.DS_Store
**/.DS_Store
/frontend/
/tests/
/data/
/artifacts/
/database/
/_to_delete/
*.joblib
__azurite*
__blobstorage__/
__queuestorage__/
/learning.py
/llm_learning.py
/ml_testing.py
/apis_tests.py
/test_experiment_context.py
/backend/prediction_testing.py
/backend/database/test_connection.py
/README.md
/pytest.ini
/requirements-dev.txt
